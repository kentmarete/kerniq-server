FROM rust:1-slim AS build
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:stable-slim
RUN useradd --system --uid 10001 app
COPY --from=build /app/target/release/{{name}} /usr/local/bin/{{name}}
COPY kerniq.toml /etc/{{name}}/kerniq.toml
WORKDIR /etc/{{name}}
USER app
EXPOSE 8080
ENV LOG_FORMAT=json
CMD ["{{name}}"]
